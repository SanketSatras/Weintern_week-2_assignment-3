        }
      ]
    },
    {
      "name": "8. User Login - Unregistered Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent@example.com\",\n  \"password\": \"SomePass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Returns generic error without revealing non-existence of user account."
      },
      "response": [
        {
          "name": "Invalid Credentials",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "body": "{\n    \"success\": false,\n    \"message\": \"Invalid email or password.\"\n}"
        }
      ]
    },
    {
      "name": "9. Get Authenticated Profile - Success",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Retrieves the user profile using the HttpOnly cookie automatically stored from the login step."
      },
      "response": [
        {
          "name": "Profile Retrieved",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n    \"success\": true,\n    \"user\": {\n        \"id\": \"671d09e1e24741366e6b8a1c\",\n        \"username\": \"alex_rivera\",\n        \"email\": \"alex.rivera@example.com\",\n        \"createdAt\": \"2026-10-26T10:15:30.000Z\"\n    }\n}"
        }
      ]
    },
    {
      "name": "10. Get Profile - Unauthorized Without Cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Accessing protected route without authentication cookie returns HTTP 401."
      },
      "response": [
        {
          "name": "Unauthorized Response",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "body": "{\n    \"success\": false,\n    \"message\": \"Please log in to access this page.\"\n}"
        }
      ]
    },
    {
      "name": "11. User Logout - Clears Cookie",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "logout"]
        },
        "description": "Clears auth_token cookie with matching Path, HttpOnly, and SameSite attributes."
      },
      "response": [
        {
          "name": "Logout Success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n    \"success\": true,\n    \"message\": \"Logged out successfully.\"\n}"
        }
      ]
    },
    {
      "name": "12. Access Protected Endpoint After Logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Verifies that after logout cookie is cleared, protected endpoint rejects request."
      },
      "response": [
        {
          "name": "Logged Out Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "body": "{\n    \"success\": false,\n    \"message\": \"Please log in to access this page.\"\n}"
        }
      ]
    }
