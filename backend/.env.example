# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5001

# Database Configuration
# Local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/authentication_system
# Isolated Test Database connection string
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/authentication_system_test

# Authentication & Security
# Generate a cryptographically secure random secret for production, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
COOKIE_NAME=auth_token
BCRYPT_SALT_ROUNDS=10
